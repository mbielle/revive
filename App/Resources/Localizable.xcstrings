    "Revive": {
      "shouldTranslate": false
    },
    "Revive checks each app's own update feed, the Mac App Store and Homebrew. Nothing else is sent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revive consulte le flux de mise à jour de chaque app, le Mac App Store et Homebrew. Rien d’autre n’est envoyé."
          }
        }
      }
    },
    "Revive looks at iCloud Drive and at Google Drive, OneDrive, Dropbox and Box folders in Finder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revive regarde iCloud Drive et les dossiers Google Drive, OneDrive, Dropbox et Box du Finder."
          }
        }
      }
    },
    "Revive needs Full Disk Access to read which apps you gave permissions to.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revive a besoin de l’accès complet au disque pour lire les autorisations données aux apps."
          }
        }
      }
    },
    "Revive needs administrator rights for this task.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revive a besoin des droits administrateur pour cette tâche."
          }
        }
      }
    },
    "Revive never scans or removes anything inside these folders.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revive n’analyse ni ne supprime jamais rien dans ces dossiers."
          }
        }
      }
    },
