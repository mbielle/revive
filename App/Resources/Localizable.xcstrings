    "%@ available on %@. Review any card, then click Run.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ disponibles sur %2$@. Vérifiez une carte, puis cliquez sur Lancer."
