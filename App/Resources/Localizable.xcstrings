    },
    "iCloud Drive": {
      "shouldTranslate": false
    },
    "macOS hides Mail, Safari, the Trash and other app data from apps by default. With Full Disk Access, Lucent can find junk there too. It never sends anything off your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, macOS cache aux apps les données de Mail, de Safari, de la Corbeille et d’autres apps. Avec l’accès complet au disque, Lucent peut aussi y trouver des fichiers inutiles. Rien ne quitte jamais votre Mac."
          }
        }
      }
    },
    "of %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sur %@"
          }
        }
      }
    },
    "of junk will be removed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "de fichiers inutiles seront supprimés"
