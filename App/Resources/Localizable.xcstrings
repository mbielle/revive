    },
    "These files have a twin with the same name and size in your cloud storage. The local one goes to the Trash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fichiers ont un jumeau de même nom et même taille dans votre cloud. La copie locale va à la Corbeille."
          }
        }
      }
    },
    "They take %@. %lld haven't been opened in 3 months.": {
