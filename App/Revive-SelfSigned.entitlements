<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for releases signed with a self-signed certificate ("Revive Release").
  Such a certificate has no Apple Team ID, so the hardened runtime's library validation would
  refuse the embedded Sparkle framework. Only that check is relaxed: DYLD environment variables
  stay blocked, and any change to the app bundle breaks its signature.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
