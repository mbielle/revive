  {
    "id": "ai-python-caches",
    "category": "aiClutter",
    "symbol": "shippingbox",
    "title": { "en": "Machine Learning Package Caches", "fr": "Caches de paquets de machine learning" },
    "detail": {
      "en": "Downloaded archives kept by pip, uv and conda. Packages are downloaded again when needed.",
      "fr": "Archives téléchargées par pip, uv et conda. Les paquets sont retéléchargés si besoin."
    },
    "paths": [
      "~/Library/Caches/pip",
      "~/.cache/pip",
      "~/.cache/uv",
      "~/.conda/pkgs/*.tar.bz2",
      "~/.conda/pkgs/*.conda",
      "~/miniconda3/pkgs/*.tar.bz2",
      "~/miniconda3/pkgs/*.conda",
      "~/anaconda3/pkgs/*.tar.bz2",
      "~/anaconda3/pkgs/*.conda",
      "~/miniforge3/pkgs/*.tar.bz2",
      "~/miniforge3/pkgs/*.conda"
    ]
  },
  {
    "id": "ai-hf-models",
    "category": "aiClutter",
    "symbol": "cpu",
    "selectedByDefault": false,
    "title": { "en": "Downloaded AI Models (Hugging Face)", "fr": "Modèles d'IA téléchargés (Hugging Face)" },
    "detail": {
      "en": "Models and datasets cached by Python AI libraries. Check that you no longer use them: they can take hours to download again.",
      "fr": "Modèles et jeux de données mis en cache par les bibliothèques Python d'IA. Vérifiez que vous ne les utilisez plus : leur retéléchargement peut prendre des heures."
    },
    "paths": [
      "~/.cache/huggingface/hub/models--*",
      "~/.cache/huggingface/hub/datasets--*",
      "~/.cache/torch/hub/checkpoints/*",
      "~/.cache/whisper/*"
    ]
  },
  {
    "id": "ai-local-model-apps",
    "category": "aiClutter",
    "symbol": "brain",
    "selectedByDefault": false,
    "title": { "en": "Local Model Libraries (Ollama, LM Studio)", "fr": "Bibliothèques de modèles locaux (Ollama, LM Studio)" },
    "detail": {
      "en": "Every model you downloaded in Ollama or LM Studio. Only remove them if you are done with local AI models.",
      "fr": "Tous les modèles téléchargés dans Ollama ou LM Studio. Ne les supprimez que si vous n'utilisez plus de modèles d'IA en local."
    },
    "paths": [
      "~/.ollama/models",
      "~/.lmstudio/models/*",
      "~/.cache/lm-studio/models/*"
    ],
    "appBundleIDs": ["com.electron.ollama", "ai.elementlabs.lmstudio"]
  }
]
